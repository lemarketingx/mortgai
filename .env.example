# Supabase Configuration (Required for leads, calendar, and documents)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Email Configuration (Required for sending reminders and custom emails)
RESEND_API_KEY=your_resend_api_key

# Admin Panel Configuration
ADMIN_PASSWORD=your_admin_password
ADMIN_SESSION_SECRET=your_session_secret

# Optional
LEAD_WEBHOOK_URL=https://your-webhook-url
OPENAI_API_KEY=your_openai_api_key

# Send email from address
FINZO_FROM_EMAIL=FINZO <support@finzo.co.il>
FINZO_ADMIN_EMAIL=admin@finzo.co.il

# App URL (for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
