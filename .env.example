# ─────────────────────────────────────────────────────────────────────────────
# FINZO — required environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Your Supabase project URL — no trailing slash, no /rest/v1 suffix.
# Example: https://abcdefghijklmn.supabase.co
SUPABASE_URL=

# Supabase service role key (secret — server-side only, never exposed to browser).
# Found in: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# Public Supabase URL used by client-side code (safe to expose).
# Must match SUPABASE_URL exactly.
NEXT_PUBLIC_SUPABASE_URL=

# ── Session secrets (REQUIRED) ────────────────────────────────────────────────
# Used to sign HMAC-SHA256 session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Each secret must be at least 32 characters and unique per environment.
ADVISOR_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# ── Admin access (REQUIRED) ───────────────────────────────────────────────────
# Password for the /admin panel. Use a strong, unique password.
ADMIN_PASSWORD=

# ── Application URLs (REQUIRED for SEO and OAuth) ────────────────────────────
# Public-facing site URL — used for canonical links and sitemaps.
# No trailing slash.  Example: https://www.finzo.co.il
NEXT_PUBLIC_SITE_URL=

# Full app URL — used for OAuth callback redirect URIs.
# Must match the callback URL configured in Supabase Auth providers.
# Example: https://www.finzo.co.il
NEXT_PUBLIC_APP_URL=

# ── WhatsApp CTA (REQUIRED for public CTAs to work) ───────────────────────────
# International phone number without +, spaces, or hyphens.
# Example: 972521234567
NEXT_PUBLIC_ADVISOR_WHATSAPP=

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Powers enhanced PDF parsing on /refinance-check.
# If absent, the endpoint falls back to heuristic text extraction (free).
OPENAI_API_KEY=

# ── Lead webhook (optional) ──────────────────────────────────────────────────
# POSTed with the full lead payload on every successful lead submission.
# Useful for CRM/Zapier integrations.
LEAD_WEBHOOK_URL=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Tag Manager container ID.  Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Search Console site verification meta tag value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
